{
  "name": "mitmproxy-ai-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo: debug and analyse HTTP traffic with mitmproxy + an MCP server for AI agents",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "npm install && ./scripts/setup-proxy.sh",
    "proxy": "./scripts/proxy.sh",
    "start": "node --use-system-ca app/server.js",
    "start:proxied": "HTTP_PROXY=http://127.0.0.1:8080 HTTPS_PROXY=http://127.0.0.1:8080 NODE_EXTRA_CA_CERTS=$HOME/.mitmproxy/mitmproxy-ca-cert.pem node app/server.js",
    "traffic": "node scripts/traffic.js"
  },
  "dependencies": {
    "undici": "^7.16.0"
  }
}
